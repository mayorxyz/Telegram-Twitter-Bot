# --- Telegram ---
BOT_TOKEN=your_telegram_bot_token
ADMIN_ID=your_telegram_user_id

# --- Timezone (IANA name, stored once into settings table on first start) ---
TIMEZONE=Africa/Lagos

# --- X / Twitter API v2 (OAuth 1.0a user context for posting) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Optional read-only bearer token (used for stats when tier allows)
TWITTER_BEARER_TOKEN=

# Legacy aliases (also honored): TWITTER_API_KEY / TWITTER_API_SECRET /
# TWITTER_ACCESS_TOKEN / TWITTER_ACCESS_SECRET

# --- RSS auto-drafts ---
RSS_URL=https://example.com/feed
RSS_MAX_PER_DAY=5
RSS_POLL_MINUTES=30

# --- Optional overrides ---
# DB_PATH=./data/bot.db
# MEDIA_DIR=./data/media
